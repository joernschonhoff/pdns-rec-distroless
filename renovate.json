{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pinDigests": true,
  "automerge": false,
  "prConcurrentLimit": 2,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "to {{newVersion}}",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Extract pdns-recursor version from VERSION file",
      "managerFilePatterns": [
        "/^VERSION$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)$"
      ],
      "datasourceTemplate": "custom.pdns-recursor-releases",
      "depNameTemplate": "pdns-recursor"
    },
    {
      "customType": "regex",
      "description": "Extract regctl version from .gitlab-ci.yml",
      "managerFilePatterns": [
        "/^\\.gitlab-ci\\.yml$/"
      ],
      "matchStrings": [
        "REGCTL_VERSION: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "regclient/regclient"
    }
  ],
  "customDatasources": {
    "pdns-recursor-releases": {
      "defaultRegistryUrlTemplate": "https://downloads.powerdns.com/releases/",
      "format": "html"
    }
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "automerge": true
    },
    {
      "description": "pdns-recursor version - update VERSION file",
      "matchFileNames": [
        "VERSION"
      ],
      "matchDatasources": [
        "custom.pdns-recursor-releases"
      ],
      "extractVersion": "^pdns-recursor-(?<version>\\d+\\.\\d+\\.\\d+)\\.tar\\.xz$",
      "commitMessageTopic": "pdns-recursor",
      "groupName": "pdns-recursor"
    },
    {
      "description": "regctl version - update REGCTL_VERSION in .gitlab-ci.yml",
      "matchFileNames": [
        ".gitlab-ci.yml"
      ],
      "matchDepNames": [
        "regclient/regclient"
      ],
      "commitMessageTopic": "regctl"
    },
    {
      "description": "Disable automatic updates for Docker image digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    }
  ]
}
